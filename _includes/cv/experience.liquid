{% comment %}
  Local override of al_folio_cv's templates/cv/experience.liquid (al_folio_cv 1.0.2).
  Differences from the gem version, kept from the v0.x site:
  - Single full-width column: position, company, then the date badge (year.month) below them.
  - `summary` is rendered as raw HTML, because assets/json/resume.json stores lists and bold text as HTML,
    which `markdownify` escapes.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush" style="list-style: none; padding-left: 0">
  {% comment %} Without Bootstrap, list-group no longer hides the bullets of the entries {% endcomment %}
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 mt-2 mt-md-0">
          {% capture position_title %}
            {% if entry.position %}{{ entry.position }}{% endif %}
          {% endcapture %}
          {% assign position_title = position_title | strip %}
          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ position_title }}</a>
            </h6>
          {% elsif position_title != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ position_title }}</h6>
          {% endif %}

          {% capture company_name %}
            {% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}
          {% endcapture %}
          {% assign company_name = company_name | strip %}
          {% if company_name != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ company_name }}</h6>
          {% endif %}

          {% capture start_date %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_date = start_date | strip %}
          {% capture end_date %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_date = end_date | strip %}
          {% if start_date != '' %}
            {% assign startDate = start_date | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = end_date | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            <p class="ml-1 ml-md-4">
              <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                {{- startDate }} - {{ endDate -}}
              </span>
            </p>
          {% endif %}

          {% if entry.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.summary }}</h6>
          {% endif %}

          {% if entry.highlights %}
            <ul class="items">
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
